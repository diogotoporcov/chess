<UserControl x:Class="Chess.Desktop.Views.Components.EvaluationBarView"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid MinWidth="44">
        <Border Background="{StaticResource EvaluationBlackBrush}"
                BorderBrush="{StaticResource BoardBorderBrush}"
                BorderThickness="2" CornerRadius="3" />
        <Border x:Name="WhiteSegment"
                Background="{StaticResource EvaluationWhiteBrush}"
                Margin="2" RenderTransformOrigin="0.5,1">
            <Border.RenderTransform>
                <ScaleTransform x:Name="WhiteScale" ScaleY="0.5" />
            </Border.RenderTransform>
        </Border>
        <Border VerticalAlignment="Center"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource SurfaceBorderBrush}"
                BorderThickness="1" Padding="4,6"
                HorizontalAlignment="Center">
            <TextBlock Text="{Binding EvaluationText, ElementName=Root}"
                       Foreground="{StaticResource TextPrimaryBrush}"
                       FontSize="12" FontWeight="Bold"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"
                       TextWrapping="NoWrap" />
        </Border>
    </Grid>
</UserControl>
