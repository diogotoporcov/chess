<UserControl x:Class="Chess.Desktop.Views.Components.ChessBoardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:Chess.Desktop.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=viewModels:GameViewModel,
                                              IsDesignTimeCreatable=False}">

    <Grid Width="{Binding BoardWidth}"
          Height="{Binding BoardHeight}"
          IsHitTestVisible="{Binding IsBoardInputEnabled}">

        <ItemsControl Width="{Binding BoardWidth}"
                      Height="{Binding BoardHeight}"
                      ItemsSource="{Binding Squares}">

            <ItemsControl.ItemsPanel>

                <ItemsPanelTemplate>
                    <Canvas />
                </ItemsPanelTemplate>

            </ItemsControl.ItemsPanel>

            <ItemsControl.ItemContainerStyle>

                <Style TargetType="{x:Type ContentPresenter}">

                    <Setter Property="Canvas.Left"
                            Value="{Binding X}" />

                    <Setter Property="Canvas.Top"
                            Value="{Binding Y}" />

                </Style>

            </ItemsControl.ItemContainerStyle>

            <ItemsControl.ItemTemplate>

                <DataTemplate DataType="{x:Type viewModels:SquareViewModel}">

                    <Button Width="{Binding Size}"
                            Height="{Binding Size}"
                            Command="{Binding DataContext.SelectSquareCommand,
                                              RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
                            CommandParameter="{Binding}"
                            Style="{StaticResource BoardSquareButtonStyle}">

                        <Grid>

                            <Ellipse Width="{Binding SelectionMarkerSize}"
                                     Height="{Binding SelectionMarkerSize}"
                                     Fill="{StaticResource BoardSelectionMarkerBrush}"
                                     Opacity="0.68"
                                     IsHitTestVisible="False">

                                <Ellipse.Style>

                                    <Style TargetType="{x:Type Ellipse}">

                                        <Setter Property="Visibility"
                                                Value="Collapsed" />

                                        <Style.Triggers>

                                            <DataTrigger
                                                Binding="{Binding IsSelected}"
                                                Value="True">

                                                <Setter Property="Visibility"
                                                        Value="Visible" />

                                            </DataTrigger>

                                        </Style.Triggers>

                                    </Style>

                                </Ellipse.Style>

                            </Ellipse>

                            <Image Source="{Binding PieceImageSource}"
                                   Width="{Binding PieceSize}"
                                   Height="{Binding PieceSize}"
                                   Stretch="Uniform"
                                   RenderOptions.BitmapScalingMode="NearestNeighbor"
                                   SnapsToDevicePixels="True"
                                   IsHitTestVisible="False" />

                            <Ellipse Width="{Binding LegalMoveMarkerSize}"
                                     Height="{Binding LegalMoveMarkerSize}"
                                     Fill="{StaticResource BoardLegalMarkerBrush}"
                                     Opacity="0.82"
                                     IsHitTestVisible="False">

                                <Ellipse.Style>

                                    <Style TargetType="{x:Type Ellipse}">

                                        <Setter Property="Visibility"
                                                Value="Collapsed" />

                                        <Style.Triggers>

                                            <DataTrigger
                                                Binding="{Binding IsLegalDestination}"
                                                Value="True">

                                                <Setter Property="Visibility"
                                                        Value="Visible" />

                                            </DataTrigger>

                                        </Style.Triggers>

                                    </Style>

                                </Ellipse.Style>

                            </Ellipse>

                            <Ellipse Width="{Binding CaptureMarkerSize}"
                                     Height="{Binding CaptureMarkerSize}"
                                     Fill="Transparent"
                                     Stroke="{StaticResource BoardLegalMarkerBrush}"
                                     StrokeThickness="{Binding CaptureMarkerStrokeThickness}"
                                     Opacity="0.92"
                                     IsHitTestVisible="False">

                                <Ellipse.Style>

                                    <Style TargetType="{x:Type Ellipse}">

                                        <Setter Property="Visibility"
                                                Value="Collapsed" />

                                        <Style.Triggers>

                                            <DataTrigger
                                                Binding="{Binding IsCaptureDestination}"
                                                Value="True">

                                                <Setter Property="Visibility"
                                                        Value="Visible" />

                                            </DataTrigger>

                                        </Style.Triggers>

                                    </Style>

                                </Ellipse.Style>

                            </Ellipse>

                        </Grid>

                    </Button>

                </DataTemplate>

            </ItemsControl.ItemTemplate>

        </ItemsControl>

        <Border BorderBrush="{StaticResource BoardBorderBrush}"
                BorderThickness="2"
                IsHitTestVisible="False" />

    </Grid>

</UserControl>
