<UserControl x:Class="Chess.Desktop.Views.Screens.StandardGameSetupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:Chess.Desktop.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=viewModels:StandardGameSetupViewModel,
                                              IsDesignTimeCreatable=False}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Border Margin="48" Style="{StaticResource ScreenContentStyle}">
            <StackPanel MaxWidth="680" HorizontalAlignment="Left">
                <Button Content="← Back" Command="{Binding BackCommand}"
                        Style="{StaticResource TextButtonStyle}"
                        HorizontalAlignment="Left" Margin="0,0,0,26" />
                <TextBlock Text="STANDARD CHESS" FontSize="28"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}" />
                <TextBlock Text="Play against" Margin="0,30,0,10"
                           Foreground="{StaticResource TextSecondaryBrush}" />
                <StackPanel Orientation="Horizontal">
                    <RadioButton GroupName="SessionType"
                                 Content="Player vs Player"
                                 IsChecked="{Binding IsLocalSelected, Mode=TwoWay}"
                                 Style="{StaticResource SetupChoiceStyle}" />
                    <RadioButton GroupName="SessionType"
                                 Content="Player vs Stockfish"
                                 IsChecked="{Binding IsStockfishSelected, Mode=TwoWay}"
                                 Style="{StaticResource SetupChoiceStyle}" />
                </StackPanel>
                <StackPanel IsEnabled="{Binding IsStockfishGame}">
                    <TextBlock Text="Play as" Margin="0,25,0,10"
                               Foreground="{StaticResource TextSecondaryBrush}" />
                    <StackPanel Orientation="Horizontal">
                        <RadioButton GroupName="HumanSide" Content="White"
                                     IsChecked="{Binding IsHumanWhite, Mode=TwoWay}"
                                     Style="{StaticResource SetupChoiceStyle}" />
                        <RadioButton GroupName="HumanSide" Content="Black"
                                     IsChecked="{Binding IsHumanBlack, Mode=TwoWay}"
                                     Style="{StaticResource SetupChoiceStyle}" />
                    </StackPanel>
                    <TextBlock Text="Difficulty" Margin="0,25,0,10"
                               Foreground="{StaticResource TextSecondaryBrush}" />
                    <ComboBox ItemsSource="{Binding Difficulties}"
                              SelectedItem="{Binding Difficulty, Mode=TwoWay}"
                              Width="220" HorizontalAlignment="Left" />
                </StackPanel>
                <TextBlock Text="Stockfish executable" Margin="0,28,0,5"
                           Foreground="{StaticResource TextPrimaryBrush}" />
                <TextBlock Text="{Binding PathHint}"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Margin="0,0,0,10" />
                <DockPanel LastChildFill="True">
                    <Button DockPanel.Dock="Right" Content="Browse"
                            Command="{Binding BrowseCommand}"
                            Style="{StaticResource SetupButtonStyle}"
                            Margin="10,0,0,0" />
                    <TextBox
                        Text="{Binding StockfishPath, UpdateSourceTrigger=PropertyChanged}"
                        VerticalContentAlignment="Center"
                        Padding="9,7" MinWidth="340" />
                </DockPanel>
                <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap"
                           Foreground="{StaticResource ErrorTextBrush}"
                           Margin="0,14,0,0" />
                <Button Content="Start Game" Command="{Binding StartCommand}"
                        Style="{StaticResource SetupButtonStyle}"
                        HorizontalAlignment="Left" Margin="0,26,0,0" />
            </StackPanel>
        </Border>
    </ScrollViewer>
</UserControl>
