<Application x:Class="Chess.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:viewModels="clr-namespace:Chess.Desktop.ViewModels"
             xmlns:screens="clr-namespace:Chess.Desktop.Views.Screens">

    <Application.Resources>
        <ResourceDictionary>

            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Colors.xaml" />
                <ResourceDictionary Source="Themes/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

            <DataTemplate DataType="{x:Type viewModels:ModeSelectionViewModel}">
                <screens:ModeSelectionView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type viewModels:GameViewModel}">
                <screens:GameView />
            </DataTemplate>

            <DataTemplate
                DataType="{x:Type viewModels:StandardGameSetupViewModel}">
                <screens:StandardGameSetupView />
            </DataTemplate>

        </ResourceDictionary>
    </Application.Resources>
</Application>
