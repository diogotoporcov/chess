            Include="Microsoft.Testing.Extensions.GitHubActionsReport"
            Version="2.4.0" />
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="..\Chess.Desktop\Chess.Desktop.csproj" />
    </ItemGroup>
</Project>
